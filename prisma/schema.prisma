// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String       @id @default(uuid())
  email                 String       @unique
  name                  String?
  encryptedRefreshToken String?
  googleId              String?      @unique
  gmailAuthorized       Boolean      @default(false)
  preferredRoles        String[]     @default([])
  deletionRequestedAt   DateTime?
  followUpDays          Int          @default(7)
  nextSendAt            DateTime?
  currentAttachmentId   String?
  createdAt             DateTime     @default(now())
  templates             Template[]
  contacts              Contact[]
  campaigns             Campaign[]
  attachments           Attachment[]
}

model Template {
  id         String     @id @default(uuid())
  userId     String
  name       String
  subject    String
  body       String
  archivedAt DateTime?
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns  Campaign[]

  @@index([userId])
}

model Contact {
  id         String    @id @default(uuid())
  userId     String
  name       String
  email      String
  company    String?
  jobRole    String?
  notes      String?
  tag        String?
  archivedAt DateTime?
  shortlistRemovedAt DateTime?
  followUpRequestedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sends      Send[]

  @@unique([userId, email])
  @@index([userId])
}

model Campaign {
  id             String      @id @default(uuid())
  userId         String
  templateId     String
  status         String
  role           String      @default("")
  idempotencyKey String?
  attachmentId   String?
  attachment     Attachment? @relation(fields: [attachmentId], references: [id], onDelete: Restrict)
  createdAt      DateTime    @default(now())
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  template       Template    @relation(fields: [templateId], references: [id])
  sends          Send[]

  @@unique([userId, idempotencyKey])
  @@index([userId])
}

model Send {
  createdAt        DateTime      @default(now())
  recipientEmail   String        @default("")
  recipientName    String        @default("")
  recipientRole    String        @default("")
  recipientCompany String        @default("")
  templateName     String        @default("")
  subject          String        @default("")
  body             String        @default("")
  mimeMessageId    String?       @unique
  deliveryState    DeliveryState @default(READY)
  attemptedAt      DateTime?
  dispatchedAt     DateTime?
  lastCheckedAt    DateTime?

  id             String     @id @default(uuid())
  campaignId     String
  contactId      String
  status         SendStatus @default(QUEUED)
  cancelledAt    DateTime?
  sentAt         DateTime?
  gmailMessageId String?
  gmailThreadId  String?
  error          String?
  campaign       Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact        Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([contactId])
  @@index([status, sentAt])
}

model Attachment {
  deletedAt   DateTime?
  id          String     @id @default(uuid())
  userId      String
  fileName    String
  createdAt   DateTime   @default(now())
  campaigns   Campaign[]
  storagePath String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum SendStatus {
  QUEUED
  CANCELLED
  SENT
  FAILED
  REPLIED
}

enum DeliveryState {
  READY
  ATTEMPTING
  UNCERTAIN
  DONE
}
